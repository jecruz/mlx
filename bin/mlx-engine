#!/usr/bin/env python3
"""CLI wrapper for the resident MLX local inference engine."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import urllib.request
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
PYTHON_DIR = ROOT / "benchmarks" / "python"
SERVICE = ROOT / "mlx_engine" / "resident_service.py"
SMOKE = PYTHON_DIR / "smoke_resident_service.py"
READY = PYTHON_DIR / "wait_resident_ready.py"
REGRESSION_SUITE = PYTHON_DIR / "run_resident_regression_suite.py"
OPERATOR_READINESS_RENDER = PYTHON_DIR / "operator_readiness_render.py"
OPERATOR_READINESS_BUNDLE = PYTHON_DIR / "operator_readiness_bundle.py"
PROMPT_PERFORMANCE_REPORT = PYTHON_DIR / "prompt_processing_performance_report.py"


def request_json(method: str, url: str, payload: dict[str, Any] | None = None):
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=120) as resp:
        return json.loads(resp.read().decode())


def serve(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(SERVICE),
        "--model",
        args.model,
        "--host",
        args.host,
        "--port",
        str(args.port),
        "--warmup-prompt-tokens",
        args.warmup_prompt_tokens,
        (
            "--warmup-profile-prefill"
            if args.warmup_profile_prefill
            else "--no-warmup-profile-prefill"
        ),
        "--warmup-mode",
        args.warmup_mode,
        "--engine-preset",
        args.engine_preset,
        "--max-concurrent-requests",
        str(args.max_concurrent_requests),
        "--max-queued-requests",
        str(args.max_queued_requests),
        "--queue-timeout-ms",
        str(args.queue_timeout_ms),
        "--prefix-cache-max-entries",
        str(args.prefix_cache_max_entries),
        "--prefix-cache-memory-limit-mb",
        str(args.prefix_cache_memory_limit_mb),
        "--prefix-cache-min-entries",
        str(args.prefix_cache_min_entries),
        "--prefix-cache-population-mode",
        args.prefix_cache_population_mode,
        "--prefix-cache-async-idle-timeout-ms",
        str(args.prefix_cache_async_idle_timeout_ms),
        "--prefix-cache-async-idle-grace-ms",
        str(args.prefix_cache_async_idle_grace_ms),
    ]
    if args.profile:
        cmd.extend(["--profile", args.profile])
    if args.require_gpu:
        cmd.append("--require-gpu")
    try:
        return subprocess.call(cmd, cwd=ROOT)
    except KeyboardInterrupt:
        return 130


def smoke(args: argparse.Namespace) -> int:
    cmd = [sys.executable, str(SMOKE), "--base-url", args.base_url]
    return subprocess.call(cmd, cwd=ROOT)


def ready(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(READY),
        "--base-url",
        args.base_url,
        "--timeout-s",
        str(args.timeout_s),
    ]
    if args.require_gpu:
        cmd.append("--require-gpu")
    if args.require_warmup:
        cmd.append("--require-warmup")
    return subprocess.call(cmd, cwd=ROOT)


def suite(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(REGRESSION_SUITE),
        "--base-url",
        args.base_url,
        "--tag",
        args.tag,
        "--requests",
        str(args.requests),
        "--prefill-runs",
        str(args.prefill_runs),
        "--prefix-repeats",
        str(args.prefix_repeats),
        "--max-tokens",
        str(args.max_tokens),
        "--prefill-max-tokens",
        str(args.prefill_max_tokens),
    ]
    if args.cold_start:
        cmd.append("--cold-start")
    if args.skip_generated_cache_safety:
        cmd.append("--skip-generated-cache-safety")
    if args.skip_generated_cache_edges:
        cmd.append("--skip-generated-cache-edges")
    if args.skip_concurrent_cancel_pressure:
        cmd.append("--skip-concurrent-cancel-pressure")
    if args.skip_async_cache_priority:
        cmd.append("--skip-async-cache-priority")
    return subprocess.call(cmd, cwd=ROOT)


def correctness(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/")
    engine = request_json("GET", f"{base_url}/engine")
    if not engine["ok"]:
        raise RuntimeError("engine did not report ok=true")
    if args.require_gpu and "gpu" not in engine["device"]["default_device"]:
        raise RuntimeError(f"engine is not on GPU: {engine['device']['default_device']}")
    if args.require_profile and not engine["profile_loaded"]:
        raise RuntimeError("engine did not load a profile")

    first = request_json(
        "POST",
        f"{base_url}/v1/chat/completions",
        {
            "model": "mlx-engine-correctness",
            "messages": [{"role": "user", "content": args.prompt}],
            "max_tokens": args.max_tokens,
            "policy": "auto",
        },
    )
    second = request_json(
        "POST",
        f"{base_url}/v1/chat/completions",
        {
            "model": "mlx-engine-correctness",
            "messages": [{"role": "user", "content": args.prompt}],
            "max_tokens": args.max_tokens,
            "policy": "auto",
        },
    )

    for label, response in (("first", first), ("second", second)):
        choice = response["choices"][0]
        content = choice["message"]["content"]
        if not content:
            raise RuntimeError(f"{label} correctness response was empty")
        if response["usage"]["completion_tokens"] <= 0:
            raise RuntimeError(f"{label} correctness response generated no tokens")
        if not response["engine_metrics"].get("prefill_selection_source"):
            raise RuntimeError(
                f"{label} correctness response did not report a prefill policy"
            )

    if args.expect_same_text:
        a = first["choices"][0]["message"]["content"]
        b = second["choices"][0]["message"]["content"]
        if a != b:
            raise RuntimeError("repeat correctness responses differed")

    metrics = request_json("GET", f"{base_url}/metrics")
    print(
        "correctness",
        "ok",
        engine["device"]["default_device"],
        engine["profile_loaded"],
        metrics["total_requests"],
        metrics["failed_requests"],
    )
    return 0


def operator_readiness(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(OPERATOR_READINESS_RENDER),
        "--bundle-json",
        args.bundle_json,
        "--format",
        args.format,
    ]
    if args.output_json:
        cmd.extend(["--output-json", args.output_json])
    if args.output_text:
        cmd.extend(["--output-text", args.output_text])
    if args.fail_on_fail:
        cmd.append("--fail-on-fail")
    return subprocess.call(cmd, cwd=ROOT)


def operator_readiness_refresh(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(OPERATOR_READINESS_BUNDLE),
        "--base-url",
        args.base_url,
        "--suite-json",
        args.suite_json,
        "--operator-quality-json",
        args.operator_quality_json,
        "--model-swap-workflow-json",
        args.model_swap_workflow_json,
        "--lower-memory-json",
        args.lower_memory_json,
        "--live-model-swap-json",
        args.live_model_swap_json,
        "--output-json",
        args.output_json,
        "--output-md",
        args.output_md,
        "--tag",
        args.tag,
    ]
    if args.fail_on_fail:
        cmd.append("--fail-on-fail")
    return subprocess.call(cmd, cwd=ROOT)


def performance_report(args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(PROMPT_PERFORMANCE_REPORT),
        "--first-turn-json",
        args.first_turn_json,
        "--lower-memory-json",
        args.lower_memory_json,
        "--quality-threshold-json",
        args.quality_threshold_json,
        "--output-json",
        args.output_json,
        "--output-md",
        args.output_md,
        "--tag",
        args.tag,
        "--target-mature-hit-ms",
        str(args.target_mature_hit_ms),
        "--min-speedup",
        str(args.min_speedup),
    ]
    if args.fail_on_fail:
        cmd.append("--fail-on-fail")
    return subprocess.call(cmd, cwd=ROOT)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Resident MLX engine CLI")
    subcommands = parser.add_subparsers(dest="command", required=True)

    serve_parser = subcommands.add_parser("serve", help="Run the resident engine")
    serve_parser.add_argument("--model", required=True)
    serve_parser.add_argument("--profile")
    serve_parser.add_argument("--host", default="127.0.0.1")
    serve_parser.add_argument("--port", type=int, default=8765)
    serve_parser.add_argument("--warmup-prompt-tokens", default="64,512")
    serve_parser.add_argument(
        "--warmup-profile-prefill",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Warm one representative prompt per profile-selected prefill step.",
    )
    serve_parser.add_argument(
        "--warmup-mode",
        choices=("sync", "async", "off"),
        default="async",
        help="Use async by default for interactive service readiness.",
    )
    serve_parser.add_argument("--require-gpu", action=argparse.BooleanOptionalAction, default=True)
    serve_parser.add_argument(
        "--engine-preset",
        choices=("custom", "sync-safe", "async-experimental", "memory-saver"),
        default="custom",
    )
    serve_parser.add_argument("--max-concurrent-requests", type=int, default=1)
    serve_parser.add_argument("--max-queued-requests", type=int, default=16)
    serve_parser.add_argument("--queue-timeout-ms", type=int, default=30000)
    serve_parser.add_argument("--prefix-cache-max-entries", type=int, default=16)
    serve_parser.add_argument("--prefix-cache-memory-limit-mb", type=float, default=0.0)
    serve_parser.add_argument("--prefix-cache-min-entries", type=int, default=0)
    serve_parser.add_argument(
        "--prefix-cache-population-mode",
        choices=("sync", "async", "off"),
        default="sync",
    )
    serve_parser.add_argument("--prefix-cache-async-idle-timeout-ms", type=int, default=30000)
    serve_parser.add_argument("--prefix-cache-async-idle-grace-ms", type=int, default=0)
    serve_parser.set_defaults(func=serve)

    smoke_parser = subcommands.add_parser("smoke", help="Smoke-test a running engine")
    smoke_parser.add_argument("--base-url", default="http://127.0.0.1:8765")
    smoke_parser.set_defaults(func=smoke)

    ready_parser = subcommands.add_parser("ready", help="Wait for engine readiness")
    ready_parser.add_argument("--base-url", default="http://127.0.0.1:8765")
    ready_parser.add_argument("--timeout-s", type=float, default=120.0)
    ready_parser.add_argument("--require-gpu", action=argparse.BooleanOptionalAction, default=True)
    ready_parser.add_argument("--require-warmup", action=argparse.BooleanOptionalAction, default=False)
    ready_parser.set_defaults(func=ready)

    suite_parser = subcommands.add_parser("suite", help="Run resident regression suite")
    suite_parser.add_argument("--base-url", default="http://127.0.0.1:8765")
    suite_parser.add_argument("--tag", default="cli-suite")
    suite_parser.add_argument("--requests", type=int, default=6)
    suite_parser.add_argument("--prefill-runs", type=int, default=5)
    suite_parser.add_argument("--prefix-repeats", type=int, default=24)
    suite_parser.add_argument("--max-tokens", type=int, default=8)
    suite_parser.add_argument("--prefill-max-tokens", type=int, default=4)
    suite_parser.add_argument("--cold-start", action="store_true")
    suite_parser.add_argument("--skip-generated-cache-safety", action="store_true")
    suite_parser.add_argument("--skip-generated-cache-edges", action="store_true")
    suite_parser.add_argument("--skip-concurrent-cancel-pressure", action="store_true")
    suite_parser.add_argument("--skip-async-cache-priority", action="store_true")
    suite_parser.set_defaults(func=suite)

    correctness_parser = subcommands.add_parser("correctness", help="Run API correctness gates")
    correctness_parser.add_argument("--base-url", default="http://127.0.0.1:8765")
    correctness_parser.add_argument("--prompt", default="Reply with one concise fact about MLX.")
    correctness_parser.add_argument("--max-tokens", type=int, default=8)
    correctness_parser.add_argument("--require-gpu", action=argparse.BooleanOptionalAction, default=True)
    correctness_parser.add_argument("--require-profile", action=argparse.BooleanOptionalAction, default=True)
    correctness_parser.add_argument("--expect-same-text", action="store_true")
    correctness_parser.set_defaults(func=correctness)

    readiness_parser = subcommands.add_parser(
        "operator-readiness",
        help="Render an operator readiness bundle for UI/TUI display",
    )
    readiness_parser.add_argument(
        "--bundle-json",
        default="artifacts/m182-operator-readiness/operator-readiness-bundle-m182-qwen-a3b.json",
    )
    readiness_parser.add_argument("--output-json")
    readiness_parser.add_argument("--output-text")
    readiness_parser.add_argument("--format", choices=("text", "json"), default="text")
    readiness_parser.add_argument("--fail-on-fail", action="store_true")
    readiness_parser.set_defaults(func=operator_readiness)

    refresh_parser = subcommands.add_parser(
        "operator-readiness-refresh",
        help="Refresh the operator readiness bundle from standard evidence artifacts",
    )
    refresh_parser.add_argument("--base-url", default="http://127.0.0.1:8773")
    refresh_parser.add_argument(
        "--suite-json",
        default="artifacts/m180-live-request-memory-suite/live-product-regression-suite-m180-qwen-a3b.json",
    )
    refresh_parser.add_argument(
        "--operator-quality-json",
        default="artifacts/m171-operator-quality-bundle/operator-quality-bundle-m171-qwen-a3b.json",
    )
    refresh_parser.add_argument(
        "--model-swap-workflow-json",
        default="artifacts/m179-model-swap-workflow/model-swap-workflow-m179-qwen27b.json",
    )
    refresh_parser.add_argument(
        "--lower-memory-json",
        default="artifacts/m180-live-request-memory-suite/lower-memory-live-gate-m180-qwen-a3b.json",
    )
    refresh_parser.add_argument(
        "--live-model-swap-json",
        default="artifacts/m181-live-model-swap/live-model-swap-m181-qwen-a3b.json",
    )
    refresh_parser.add_argument(
        "--output-json",
        default="artifacts/operator-readiness/operator-readiness-bundle.json",
    )
    refresh_parser.add_argument(
        "--output-md",
        default="artifacts/operator-readiness/operator-readiness-bundle.md",
    )
    refresh_parser.add_argument("--tag", default="operator-readiness-refresh")
    refresh_parser.add_argument("--fail-on-fail", action="store_true")
    refresh_parser.set_defaults(func=operator_readiness_refresh)

    perf_parser = subcommands.add_parser(
        "performance-report",
        help="Build a prompt-processing performance report from gated artifacts",
    )
    perf_parser.add_argument(
        "--first-turn-json",
        default="artifacts/m180-live-request-memory-suite/request-scoped-gates-m180-qwen-a3b/m137_first_reusable_turn_latency-m180-qwen-a3b.json",
    )
    perf_parser.add_argument(
        "--lower-memory-json",
        default="artifacts/m180-live-request-memory-suite/lower-memory-live-gate-m180-qwen-a3b.json",
    )
    perf_parser.add_argument(
        "--quality-threshold-json",
        default="artifacts/m180-live-request-memory-suite/quality-threshold-gate-m180-qwen-a3b.json",
    )
    perf_parser.add_argument(
        "--output-json",
        default="artifacts/performance/prompt-processing-performance-report.json",
    )
    perf_parser.add_argument(
        "--output-md",
        default="artifacts/performance/prompt-processing-performance-report.md",
    )
    perf_parser.add_argument("--tag", default="performance-report")
    perf_parser.add_argument("--target-mature-hit-ms", type=float, default=175.0)
    perf_parser.add_argument("--min-speedup", type=float, default=4.0)
    perf_parser.add_argument("--fail-on-fail", action="store_true")
    perf_parser.set_defaults(func=performance_report)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
